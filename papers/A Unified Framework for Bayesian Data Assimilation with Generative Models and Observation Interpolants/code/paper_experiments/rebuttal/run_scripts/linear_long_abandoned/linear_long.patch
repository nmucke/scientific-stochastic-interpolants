+def test_linear_long_variant_changes_only_the_interval(tmp_path, monkeypatch):
+    """``--obs linear_long``: the linear problem with ``problem_linear_long`` merged
+    in, recorded as ``variant``; the operator sweeps keep their dictionaries."""
+    raw = OmegaConf.load(driver.CASE_CONFIG)
+    interval = float(raw.problem_linear_long.interval)
+    assert interval > LINEAR_DICT["interval"]
+    cfg = driver.case_config("linear_long")
+    problem = driver.problem_of(cfg)
+    assert problem == load_problem(obs="linear_long")
+    assert problem.to_dict() == {**LINEAR_DICT, "interval": interval, "variant": "linear_long"}
+    assert problem.linear_obs and problem.obs_nonlinearity is None
+    assert problem.obs_label == "linear_long" and problem.model.interval == interval
+    assert pf_gate.reference_proposal(problem) == "optimal"  # exact for any interval
+    assert problem.dynamics() == problem
+    assert cfg.evaluation.test_sequences == 3 and cfg.obs == "linear_long"
+    assert driver.method_settings(cfg, "enkf") == driver.method_settings(driver.case_config(), "enkf")
+    # Same sites and noise draws; the truth follows the longer interval.
+    seq = make_sequence(problem, 7)
+    linear_seq = make_sequence(Problem(), 7)
+    assert not torch.allclose(seq.truth[1], linear_seq.truth[1])
+    noise = seq.observations - seq.truth[1:, problem.obs_indices]
+    linear_noise = linear_seq.observations - linear_seq.truth[1:, problem.obs_indices]
+    torch.testing.assert_close(noise, linear_noise, rtol=0, atol=1e-12)
+    # The operator sweeps are untouched: no variant key, the base interval.
+    for obs in ("linear", "arctan", "square"):
+        other = driver.problem_of(driver.case_config(obs))
+        assert "variant" not in other.to_dict() and other.interval == LINEAR_DICT["interval"]
+        assert other.obs_label == obs
+    # Paths, scenario and the runner.
+    monkeypatch.setattr(driver, "RESULTS", tmp_path)
+    assert driver.reference_path("test", 0, 1, problem.obs_label).parts[-4] == "linear_long"
+    assert driver.SCENARIOS["linear_long"] is Scenario.LORENZ96_LINEAR_LONG
+    runner = driver.Lorenz96Runner(
+        OmegaConf.create(
+            dict(
+                case=OmegaConf.to_container(raw),
+                scenario=dict(name="lorenz96_linear_long"),
+                method=dict(name="EnKF"),
+            )
+        )
+    )
+    assert runner.obs == "linear_long"
+    # References of the base linear problem are refused, and so is the 0.2 data.
+    assert Problem().to_dict() != problem.to_dict()
+    path = tmp_path / "data.npz"
+    np.savez(path, mean=2.2, std=4.0, problem=json.dumps(LINEAR_DICT), states=np.zeros(1))
+    with pytest.raises(ValueError, match="different problem"):
+        Standardisation.from_data(path, problem)
+    # A variant block may not change the operator or its own name.
+    bad = OmegaConf.load(driver.CASE_CONFIG)
+    bad.problem_linear_long.observation = {"operator": "square"}
+    with pytest.raises(ValueError, match="may not set"):
+        driver.configure(bad, "linear_long")
+
