# Generated TeX intermediates; keep source, build recipe, tables and figures.
*.aux
*.bbl
*.blg
*.fdb_latexmk
*.fls
*.log
*.out
# Downloaded original article bodies are reproducible from source notes.
sources/*.html
sources/*.txt
paper/template/*.zip
# Local checkpoint/data payloads are outside this folder.

# Long-horizon raw states and resumable RNG/history payloads remain local.
results/long_horizon/**/raw_states/
results/long_horizon/**/*.pt
results/long_rollout/**/raw_states/
results/long_rollout/**/*.pt
# Optional assumed-parameter PDE helper snapshots are local payloads as well.
results/long_horizon/**/*.npy
results/long_rollout/**/*.npy
